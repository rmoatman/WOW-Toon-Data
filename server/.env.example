# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# ---- Database ----
# MongoDB Atlas connection string, or mongodb://127.0.0.1:27017/wow-toon-data locally
MONGO_URI=mongodb://127.0.0.1:27017/wow-toon-data

# ---- Auth (used from M2 onward) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# 32-byte key (hex) used to encrypt stored Battle.net refresh tokens
TOKEN_ENCRYPTION_KEY=change-me-32-byte-hex

# ---- Demo account ----
# `npm run seed --workspace server` creates the read-only demo user.
# `SNAPSHOT_SOURCE_EMAIL=you@example.com npm run snapshot --workspace server`
# copies that account's characters/achievements/quests/collections into the demo
# so portfolio visitors see a populated, read-only app.
DEMO_EMAIL=demo@wow-toon-data.app
DEMO_PASSWORD=demopass123

# ---- Blizzard Battle.net API (used from M3 onward) ----
# Create a client at https://develop.battle.net
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REDIRECT_URI=http://localhost:5000/api/blizzard/callback
BLIZZARD_REGION=us

# ---- Email / forgot-password (used from M2 onward) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=WOW-Toon-Data <no-reply@wow-toon-data.app>
# If EMAIL_HOST/USER are blank, reset links are printed to the server console.
