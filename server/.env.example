# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# ---- Database ----
# MongoDB Atlas connection string, or mongodb://127.0.0.1:27017/wow-toon-data locally
MONGO_URI=mongodb://127.0.0.1:27017/wow-toon-data

# ---- Auth (used from M2 onward) ----
JWT_SECRET=change-me-to-a-long-random-string
# 32-byte key (hex) used to encrypt stored Battle.net refresh tokens
TOKEN_ENCRYPTION_KEY=change-me-32-byte-hex

# ---- Blizzard Battle.net API (used from M3 onward) ----
# Create a client at https://develop.battle.net
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REDIRECT_URI=http://localhost:5000/api/blizzard/callback
BLIZZARD_REGION=us

# ---- Email / forgot-password (used from M2 onward) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
